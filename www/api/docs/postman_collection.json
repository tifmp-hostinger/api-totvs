              "raw": "{\n  \"parametros\": {\n    \"CPF_S\": \"12345678901\",\n    \"RNM_S\": \"0\"\n  },\n  \"codcoligada\": \"0\",\n  \"codsistema\": \"G\"\n}",
              "options": {
